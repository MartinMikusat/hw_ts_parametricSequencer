{
	"name": "hw-ts-parametric-sequencer",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && esbuild src/index.ts --bundle --format=esm --platform=neutral --packages=external --sourcemap --outfile=dist/index.js && tsc -p tsconfig.build.json",
		"prepare": "npm run build",
		"check": "tsc --noEmit",
		"test": "vitest --run",
		"oracle": "esbuild scripts/write_oracle.ts --bundle --platform=node --format=esm --outfile=build/write_oracle.mjs --log-level=warning && node build/write_oracle.mjs"
	},
	"dependencies": {
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"esbuild": "^0.28.2",
		"typescript": "^5.9.3",
		"vitest": "^4.0.15"
	}
}
